{
  "name": "ohmyui-i18n",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/ohmyui-i18n",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node generate.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node generate.mjs --check",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packages/ohmyui-angular/src/lib/i18n/messages.ts"
      ],
      "cache": true
    }
  }
}
